includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 10
    paths:
        - src
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Eloquent Builder overrides cannot preserve TModel through parent:: calls at level 10.
        -
            identifier: return.type
            path: src/Eloquent/CachedBuilder.php
